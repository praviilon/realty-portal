# Шаблон .env для боевого размещения на shared-хостинге Timeweb.
#
# Как пользоваться:
#   1) скопировать в корень проекта под именем .env
#   2) заполнить все значения в угловых скобках <...>
#   3) сгенерировать ключ приложения:  php artisan key:generate
#   4) применить миграции:             php artisan migrate --force
#   5) создать симлинк для фото:       php artisan storage:link
#
# Сам .env в репозиторий не коммитится (он в .gitignore) — это нормально
# и правильно: в нём боевые пароли. Этот файл — только шаблон без секретов.

APP_NAME="Smart Realty"
APP_ENV=production
# Заполняется командой php artisan key:generate — в репозиторий реальный ключ
# класть нельзя: им шифруются сессионные куки и любые encrypt()-данные.
APP_KEY=
APP_DEBUG=false
# без завершающего слэша — иначе в некоторых сгенерированных URL получается двойной //
APP_URL=https://<ваш-домен>

# было en — из-за этого все ошибки валидации, входа и восстановления пароля
# показывались на сайте по-английски, хотя в проекте есть lang/ru
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# было debug — на проде это лишний мусор в логах и риск забить диск
LOG_LEVEL=warning

# ГЛАВНОЕ ИСПРАВЛЕНИЕ: было sqlite, из-за чего все параметры ниже игнорировались,
# а имя базы использовалось как ИМЯ ФАЙЛА SQLite в корне проекта.
# Симптом был такой: сайт работает штатно, но база в панели хостинга пустая,
# потому что все данные молча уходили в файл. Если снова увидите пустую базу —
# в первую очередь проверяйте именно эту строку.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<имя базы>
DB_USERNAME=<на timeweb это поле совпадает с именем базы>
DB_PASSWORD=<пароль базы>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# на проде под https — куки только по защищённому соединению
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# было log — письма (в т.ч. восстановление пароля) никуда не уходили,
# только писались в storage/logs. Заполните SMTP хостинга, иначе
# пользователи не смогут восстановить пароль.
# Точные хост/порт лучше сверить в панели управления хостингом.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.timeweb.ru
MAIL_PORT=465
MAIL_USERNAME=<почтовый ящик на вашем домене>
MAIL_PASSWORD=<пароль от почтового ящика>
MAIL_FROM_ADDRESS="noreply@<ваш-домен>"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Раздел 7.5 технического плана
YANDEX_MAPS_API_KEY=
# Пустые ключи = капча отключена (SmartCaptchaVerifier пропускает любой
# непустой токен). Для боевого сайта регистрацию и вход лучше прикрыть.
SMARTCAPTCHA_SITE_KEY=
SMARTCAPTCHA_SERVER_KEY=
